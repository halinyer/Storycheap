# StoryCheap Environment Variables (Copy to .env.local for local dev, configure in Vercel for production)

# --- Site & App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Server & Public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cryptography (REQUIRED in production: 32-byte base64 or 64-char hex key for AES-256-GCM code vault) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_ENCRYPTION_KEY=

# --- ZenoBank Crypto Payment Gateway ---
ZENOBANK_API_KEY=
ZENOBANK_WEBHOOK_SECRET=
ZENOBANK_BASE_URL=https://api.zenobank.io

# --- Resend Transactional Email (storycheap.com verified domain in Zoho/DNS) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=StoryCheap <no-reply@storycheap.com>

# --- Reloadly Digital Goods (Optional fallback ONLY if account is legitimately KYC verified) ---
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true

# --- Cron & Security ---
CRON_SECRET=

# --- Local Demo / Sandbox Mode ---
# Set to "true" ONLY in local dev when Supabase/ZenoBank keys are not yet provisioned.
# In production (NODE_ENV=production), demo sandbox routes refuse to run unless explicitly overridden for staging.
ENABLE_DEMO_SANDBOX=true
